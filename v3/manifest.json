{
  "manifest_version": 3,
  "version": "0.4.7",
  "name": "Always active Window - Always Visible",
  "default_locale": "en",
  "description": "__MSG_description__",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_title": "Toggle whether the current website stays active while its tab is in the background. The button announces the current state: the badge shows ON or OFF (R when a reload is recommended or required), and the button label (title) names the website and whether it is enabled. Clicking applies the change immediately to the open tab when possible.",
    "default_icon": {
      "16": "data/icons/disabled/16.png",
      "32": "data/icons/disabled/32.png",
      "48": "data/icons/disabled/48.png"
    }
  },
  "homepage_url": "https://webextension.org/listing/always-active.html",
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png",
    "256": "data/icons/256.png",
    "512": "data/icons/512.png"
  },
  "background": {
    "service_worker": "worker.js",
    "scripts": ["worker.js"]
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "data/options/index.html"
  },
  "commands": {
    "_execute_action": {}
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{4b7825da-0dd1-44f9-9717-bee5b2408af6}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
